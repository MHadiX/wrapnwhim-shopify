<section class="section page-width prose-page"><a href="{{ routes.account_url }}">← Your account</a><h1>Your addresses.</h1>{% paginate customer.addresses by 10 %}{% for address in customer.addresses %}<div class="account-order">{{ address | format_address }}<details><summary>Edit address</summary>{% form 'customer_address', address %}{% render 'address-fields', form: form, id: address.id %}<button class="button" type="submit">Save address</button>{% endform %}</details><form method="post" action="{{ routes.account_addresses_url }}/{{ address.id }}"><input type="hidden" name="_method" value="delete"><button class="text-button" type="submit">Delete address</button></form></div>{% endfor %}{% render 'pagination', paginate: paginate %}{% endpaginate %}<details><summary>Add a new address</summary>{% form 'customer_address', customer.new_address %}{% render 'address-fields', form: form, id: 'new' %}<button type="submit" class="button">Add address</button>{% endform %}</details></section>
