<section class="section page-width prose-page"><a href="{{ routes.account_url }}">← Your account</a><h1>Order {{ order.name }}</h1><p>{{ order.created_at | date: '%B %d, %Y' }} · {{ order.financial_status_label }} · {{ order.fulfillment_status_label }}</p>{% if order.cancelled %}<p>Cancelled: {{ order.cancel_reason_label }}</p>{% endif %}{% for item in order.line_items %}<article class="account-order"><h2>{{ item.title | escape }}</h2><p>{{ item.quantity }} × {{ item.final_price | money_with_currency }}</p><dl class="line-properties">{% for property in item.properties %}{% assign first = property.first | slice: 0 %}{% if first != '_' and property.last != blank %}<div><dt>{{ property.first | escape }}</dt><dd>{{ property.last | escape }}</dd></div>{% endif %}{% endfor %}</dl>{% if item.fulfillment %}<p>{{ item.fulfillment.tracking_company | escape }}{% if item.fulfillment.tracking_url %} <a href="{{ item.fulfillment.tracking_url }}">Track shipment {{ item.fulfillment.tracking_number | escape }}</a>{% endif %}</p>{% endif %}</article>{% endfor %}<p>Total: {{ order.total_net_amount | money_with_currency }}</p></section>
