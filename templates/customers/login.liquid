<section class="section page-width prose-page"><h1>Welcome back.</h1>{% form 'customer_login' %}{{ form.errors | default_errors }}<label class="field">Email<input type="email" name="customer[email]" autocomplete="email" required></label><label class="field">Password<input type="password" name="customer[password]" autocomplete="current-password" required></label><button class="button" type="submit">Sign in</button>{% endform %}<a href="{{ routes.account_register_url }}">Create an account</a><details id="recover"><summary>Forgot your password?</summary>{% form 'recover_customer_password' %}{{ form.errors | default_errors }}{% if form.posted_successfully? %}<p role="status">Check your email for password reset instructions.</p>{% endif %}<label class="field">Email<input type="email" name="email" autocomplete="email" required></label><button type="submit" class="button">Reset password</button>{% endform %}</details></section>
