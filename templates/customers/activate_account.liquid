<section class="section page-width prose-page"><h1>Set your password.</h1>{% form 'activate_customer_password' %}{{ form.errors | default_errors }}<label class="field">Password<input type="password" name="customer[password]" autocomplete="new-password" required minlength="5"></label><label class="field">Confirm password<input type="password" name="customer[password_confirmation]" autocomplete="new-password" required minlength="5"></label><button type="submit" class="button">Save password</button>{% endform %}</section>
