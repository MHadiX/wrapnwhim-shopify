<section class="section page-width prose-page"><h1>Join WrapnWhim.</h1>{% form 'create_customer' %}{{ form.errors | default_errors }}<label class="field">First name<input name="customer[first_name]" autocomplete="given-name"></label><label class="field">Last name<input name="customer[last_name]" autocomplete="family-name"></label><label class="field">Email<input type="email" name="customer[email]" autocomplete="email" required></label><label class="field">Password<input type="password" name="customer[password]" autocomplete="new-password" required minlength="5"></label><button type="submit" class="button">Create account</button>{% endform %}</section>
