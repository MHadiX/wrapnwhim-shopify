<section class="section page-width"><h1>Your account.</h1><p>{{ customer.name | escape }}</p><a href="{{ routes.account_logout_url }}">Sign out</a><a href="{{ routes.account_addresses_url }}">Manage addresses</a><h2>Your orders</h2>{% paginate customer.orders by 10 %}{% for order in customer.orders %}<article class="account-order"><a href="{{ order.customer_url }}">{{ order.name }}</a><span>{{ order.created_at | date: '%B %d, %Y' }}</span><span>{{ order.financial_status_label }}</span><span>{{ order.fulfillment_status_label }}</span><span>{{ order.total_net_amount | money_with_currency }}</span></article>{% else %}<p>No orders yet.</p><a class="button" href="{{ routes.all_products_collection_url }}">Find a thoughtful gift</a>{% endfor %}{% render 'pagination', paginate: paginate %}{% endpaginate %}</section>
