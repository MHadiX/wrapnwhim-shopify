<div class="active-filters">{% for filter in results.filters %}{% for value in filter.active_values %}<a href="{{ value.url_to_remove }}" aria-label="Remove {{ filter.label | escape }}: {{ value.label | escape }} filter">{{ value.label | escape }} <span aria-hidden="true">×</span></a>{% endfor %}{% if filter.type == 'price_range' %}{% if filter.min_value.value or filter.max_value.value %}<a href="{{ filter.url_to_remove }}">Clear price range <span aria-hidden="true">×</span></a>{% endif %}{% endif %}{% endfor %}</div>
