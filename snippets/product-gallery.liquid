<product-gallery><div class="gallery-main" data-gallery-track>{% for media in product.media %}{% liquid
  assign media_loading = 'lazy'
  if forloop.first
    assign media_loading = 'eager'
  endif
%}<div class="gallery-frame" id="Media-{{ section.id }}-{{ media.id }}" data-media-id="{{ media.id }}" {% unless forloop.first %}hidden{% endunless %}>{% case media.media_type %}{% when 'image' %}<button class="gallery-zoom" type="button" data-zoom aria-label="Enlarge {{ media.alt | default: product.title | escape }}" data-full-src="{{ media | image_url: width: 2400 }}">{{ media | image_url: width: 1600 | image_tag: widths: '480,800,1000,1200,1600', sizes: '(min-width: 990px) 55vw, 100vw', loading: media_loading }}<span aria-hidden="true">{% render 'icon', name: 'expand' %}</span></button>{% when 'video' %}{{ media | video_tag: controls: true, preload: 'metadata', image_size: '1000x' }}{% when 'external_video' %}{{ media | external_video_tag: loading: 'lazy' }}{% when 'model' %}{{ media | model_viewer_tag: reveal: 'interaction', toggleable: true, image_size: '1000x' }}{% endcase %}</div>{% else %}{{ 'product-1' | placeholder_svg_tag: 'placeholder' }}{% endfor %}</div><div class="gallery-thumbs">{% for media in product.media %}<button type="button" data-thumbnail="{{ media.id }}" aria-label="Show {{ media.media_type }} {{ forloop.index }}" aria-pressed="{% if forloop.first %}true{% else %}false{% endif %}">{{ media.preview_image | image_url: width: 160 | image_tag: loading: 'lazy', widths: '80,160', sizes: '80px' }}</button>{% endfor %}</div><dialog class="image-modal" aria-label="Fullscreen product image"><button type="button" class="icon-button" data-close aria-label="Close image">{% render 'icon', name: 'close' %}</button><img data-full-image alt="{{ product.title | escape }}" width="1600" height="1600"><p>Pinch or scroll to inspect the details.</p></dialog></product-gallery>
