{% liquid
 assign current_variant = product.selected_or_first_available_variant
 assign form_id = 'ProductForm-' | append: section.id | append: '-' | append: product.id
%}
<product-form data-product-url="{{ product.url }}" data-product-title="{{ product.title | escape }}"><script type="application/json" data-variants>{{ product.variants | json }}</script><script type="application/json" data-product-options>{{ product.options | json }}</script>{% form 'product', product, id: form_id, class: 'product-form', enctype: 'multipart/form-data' %}<div class="no-js-variant field"><label for="Variant-{{ form_id }}">Gift option</label><select name="id" id="Variant-{{ form_id }}" data-variant-select>{% for variant in product.variants %}<option value="{{ variant.id }}" {% if variant.id == current_variant.id %}selected{% endif %} {% unless variant.available %}disabled{% endunless %}>{{ variant.title | escape }} — {{ variant.price | money_with_currency }}{% unless variant.available %} · Sold out{% endunless %}</option>{% endfor %}</select></div>{% unless product.has_only_default_variant %}<div data-option-controls hidden>{% for option in product.options_with_values %}<fieldset class="variant-options" data-option-index="{{ forloop.index0 }}"><legend>{{ option.name | escape }}</legend>{% for value in option.values %}<label class="variant-chip"><input type="radio" name="option-{{ form_id }}-{{ option.position }}" value="{{ value | escape }}" {% if option.selected_value == value %}checked{% endif %}><span>{{ value | escape }}</span></label>{% endfor %}</fieldset>{% endfor %}</div>{% endunless %}<div class="product-price" data-product-price>{{ current_variant.price | money_with_currency }}{% if current_variant.compare_at_price > current_variant.price %} <s>{{ current_variant.compare_at_price | money_with_currency }}</s>{% endif %}</div><p class="availability" data-availability>{% if current_variant.available %}Available{% else %}Sold out{% endif %}</p><p class="muted sku" data-sku {% if current_variant.sku == blank %}hidden{% endif %}>SKU: {{ current_variant.sku | escape }}</p>{% render 'personalization', product: product, section: section, form_id: form_id %}<div class="purchase-row"><div class="quantity-control"><button type="button" data-quantity-minus aria-label="Decrease quantity">−</button><label class="sr-only" for="Quantity-{{ form_id }}">Quantity</label><input id="Quantity-{{ form_id }}" type="number" name="quantity" min="{{ current_variant.quantity_rule.min | default: 1 }}" step="{{ current_variant.quantity_rule.increment | default: 1 }}" {% if current_variant.quantity_rule.max %}max="{{ current_variant.quantity_rule.max }}"{% endif %} value="{{ current_variant.quantity_rule.min | default: 1 }}" inputmode="numeric"><button type="button" data-quantity-plus aria-label="Increase quantity">+</button></div><button class="button add-button" name="add" type="submit" {% unless current_variant.available %}disabled{% endunless %} data-add>{% if current_variant.available %}Add to gift bag{% else %}Sold out{% endif %} {% render 'icon', name: 'bag' %}</button></div><p class="form-error" data-form-error role="alert"></p>{% if section.settings.show_dynamic_checkout %}{{ form | payment_button }}<small>Review your gift options before using express checkout.</small>{% endif %}{% endform %}<p class="delivery-note">{% render 'icon', name: 'truck' %} {{ settings.delivery_message | escape }}</p><p class="muted">{{ settings.cod_message | escape }}</p></product-form>
