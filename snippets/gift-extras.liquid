{% liquid
 assign extras = product.metafields.custom.gift_extras.value
 if extras == blank
  assign extras = settings.default_gift_extras
 endif
%}
<section class="gift-extras" data-gift-extras>
 <h3>Make It Extra Special</h3><p class="muted">Add a little more love to your gift with handpicked extras.</p>
 <noscript><p>Enable JavaScript to select extras and see your customized total. Your gift message can still be added with the gift.</p></noscript>
 <div class="field extra-picker" data-extra-picker-field hidden><span class="extra-picker-label" id="{{ form_id }}-extra-label">Additional products</span><details class="extra-menu" data-extra-menu><summary aria-labelledby="{{ form_id }}-extra-label {{ form_id }}-extra-prompt"><span id="{{ form_id }}-extra-prompt">Choose an extra to add</span><span aria-hidden="true">⌄</span></summary><div class="extra-options" role="group" aria-labelledby="{{ form_id }}-extra-label" data-extra-options></div></details><select hidden aria-label="Additional products" id="{{ form_id }}-extra-picker" data-extra-picker><option value="">Choose an extra to add</option></select><small>Choose an item to add it to your gift. You can add more than one.</small><p data-extra-empty hidden>No additional products are currently available.</p></div>
 <div class="extra-grid" data-extra-grid hidden>
 {% for extra in extras limit: 12 %}{% unless extra.id == product.id or extra.requires_selling_plan or extra.metafields.custom.photo_upload_enabled.value or extra.metafields.custom.personalization_enabled.value or extra.template_suffix == 'personalized' %}
 {% assign extra_id = form_id | append: '-extra-' | append: extra.id %}
 <article class="extra-card" data-extra-card hidden data-handle="{{ extra.handle | escape }}" data-max="{{ extra.metafields.custom.gift_extra_max_quantity.value | default: settings.gift_extra_max | default: 5 }}">
 {% if extra.featured_image %}{{ extra.featured_image | image_url: width: 240 | image_tag: widths: '120,240', sizes: '80px', loading: 'lazy', class: 'extra-image' }}{% endif %}
 <div><div class="extra-choice"><input id="{{ extra_id }}" type="checkbox" hidden data-extra-select {% unless extra.available %}disabled{% endunless %}><span>{{ extra.title | escape }}</span></div>
 <p data-extra-price>{{ extra.selected_or_first_available_variant.price | money_with_currency }}</p>
 <label class="sr-only" for="{{ extra_id }}-variant">Option for {{ extra.title | escape }}</label><select id="{{ extra_id }}-variant" data-extra-variant {% if extra.has_only_default_variant %}hidden{% endif %}>{% for variant in extra.variants %}<option value="{{ variant.id }}" {% unless variant.available %}disabled{% endunless %} {% if variant.id == extra.selected_or_first_available_variant.id %}selected{% endif %}>{{ variant.title | escape }}{% unless variant.available %} — Sold Out{% endunless %}</option>{% endfor %}</select>
 <div class="extra-quantity"><label for="{{ extra_id }}-quantity">Quantity</label><input id="{{ extra_id }}-quantity" data-extra-quantity type="number" value="1" min="1" inputmode="numeric" disabled></div><button type="button" class="extra-remove" data-extra-remove aria-label="Remove {{ extra.title | escape }}">Remove</button><small data-extra-availability>{% if extra.available %}Available{% else %}Sold Out{% endif %}</small></div>
 <script type="application/json" data-extra-data>{{ extra.variants | json }}</script>
 </article>{% endunless %}{% endfor %}
 </div>
 <div class="extra-touch"><h3>Add a Personal Touch</h3>{% unless greeting_enabled %}<div class="field"><label for="{{ form_id }}-gift-message">Gift message (optional)</label><textarea id="{{ form_id }}-gift-message" name="properties[Gift message]" maxlength="250" rows="3" placeholder="Write something special for the person receiving this gift..." data-counter data-preview-field="message"></textarea><small data-count-for="{{ form_id }}-gift-message">0 / 250</small></div>{% endunless %}
 <div class="extra-names"><div class="field"><label for="{{ form_id }}-sender">Sender name (optional)</label><input id="{{ form_id }}-sender" name="properties[Sender name]" maxlength="60"></div><div class="field"><label for="{{ form_id }}-recipient">Gift recipient (optional)</label><input id="{{ form_id }}-recipient" name="properties[Gift recipient]" maxlength="60"></div></div></div>
 <dl class="extra-summary" data-extra-summary hidden><div><dt>Main gift</dt><dd data-base-total></dd></div><div><dt>Selected extras</dt><dd data-extras-total></dd></div><div class="extra-total"><dt>Estimated total</dt><dd data-gift-total></dd></div></dl><small>Shopify confirms final prices, availability, discounts, shipping, and taxes in your bag and at checkout.</small>
</section>
