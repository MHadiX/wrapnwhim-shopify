<details class="catalog-filters" open data-catalog-filters>
  <summary class="filter-toggle">Filter &amp; sort {% render 'icon', name: 'filter' %}</summary>
  <form class="collection-filters" method="get">
    <div class="filter-heading"><h2>Refine your gifts</h2><a class="text-link" href="{{ results.url | default: routes.search_url }}{% if request.page_type == 'search' %}?q={{ search.terms | url_encode }}&amp;type=product{% endif %}">Reset</a></div>
    {% if request.page_type == 'search' %}<input type="hidden" name="q" value="{{ search.terms | escape }}"><input type="hidden" name="type" value="product">{% endif %}
    {% for filter in results.filters %}
      <details class="filter-group" open><summary>{{ filter.label | escape }}{% if filter.active_values.size > 0 %} ({{ filter.active_values.size }}){% endif %}</summary>
        {% case filter.type %}
        {% when 'boolean', 'list' %}
          {% for value in filter.values %}<label class="check-label"><input type="checkbox" name="{{ value.param_name }}" value="{{ value.value | escape }}" {% if value.active %}checked{% endif %} {% if value.count == 0 and value.active == false %}disabled{% endif %}>{{ value.label | escape }} <span>({{ value.count }})</span></label>{% endfor %}
        {% when 'price_range' %}
          <div class="price-filter"><label>From ({{ cart.currency.iso_code }})<input type="number" name="{{ filter.min_value.param_name }}" min="0" max="{{ filter.range_max | divided_by: 100.0 }}" step="0.01" {% if filter.min_value.value %}value="{{ filter.min_value.value | divided_by: 100.0 }}"{% endif %}></label><label>To ({{ cart.currency.iso_code }})<input type="number" name="{{ filter.max_value.param_name }}" min="0" max="{{ filter.range_max | divided_by: 100.0 }}" step="0.01" {% if filter.max_value.value %}value="{{ filter.max_value.value | divided_by: 100.0 }}"{% endif %}></label></div>
        {% endcase %}
      </details>
    {% endfor %}
    <label class="field">Sort by<select name="sort_by">{% assign current_sort = results.sort_by | default: results.default_sort_by %}{% for option in results.sort_options %}<option value="{{ option.value }}" {% if option.value == current_sort %}selected{% endif %}>{{ option.name | escape }}</option>{% endfor %}</select></label>
    <button class="button" type="submit">Apply filters {% render 'icon', name: 'arrow' %}</button>
  </form>
</details>
