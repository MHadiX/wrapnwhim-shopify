<nav class="breadcrumbs" aria-label="Breadcrumb"><a href="{{ routes.root_url }}">Home</a><span aria-hidden="true">/</span>{% if collection %}<a href="{{ collection.url }}">{{ collection.title | escape }}</a>{% if product %}<span aria-hidden="true">/</span>{% endif %}{% endif %}{% if product %}<span aria-current="page">{{ product.title | escape }}</span>{% elsif page %}<span aria-current="page">{{ page.title | escape }}</span>{% elsif request.page_type == 'search' %}<span aria-current="page">Search</span>{% endif %}</nav>
