{% if cart.empty? %}<div class="empty-cart"><p class="eyebrow">A LITTLE JOY AWAITS</p><h3>Your bag is waiting for something thoughtful.</h3><p>Find a gift that feels just right.</p><a class="button" href="{{ routes.all_products_collection_url }}">Explore the collection</a></div>{% else %}<form action="{{ routes.cart_url }}" method="post" class="cart-form" data-cart-form><div class="cart-lines">{% for item in cart.items %}
 {% assign group = item.properties._wnw_group %}
 {% if item.properties._wnw_role == 'parent' and group != blank %}
  {% assign bundle_total = item.final_line_price %}
  <div class="cart-gift-group">{% render 'cart-line', item: item, cart_context: cart_context, section: section %}
  <div class="cart-gift-extras"><h4>Your Extras</h4>{% assign has_extras = false %}
  {% for extra in cart.items %}{% if extra.properties._wnw_group == group and extra.properties._wnw_role == 'extra' %}{% assign has_extras = true %}{% assign bundle_total = bundle_total | plus: extra.final_line_price %}{% render 'cart-line', item: extra, cart_context: cart_context, section: section %}{% endif %}{% endfor %}
  {% unless has_extras %}<p class="muted">No extras selected.</p>{% endunless %}</div>
  <p class="cart-bundle-total">Gift total after line discounts <span>{{ bundle_total | money_with_currency }}</span></p><small>Order-level discounts are included in the bag subtotal below. Removing the main gift also removes its extras when JavaScript is enabled.</small></div>
 {% elsif item.properties._wnw_role == 'extra' and group != blank %}
  {% assign parent_present = false %}{% for parent in cart.items %}{% if parent.properties._wnw_group == group and parent.properties._wnw_role == 'parent' %}{% assign parent_present = true %}{% endif %}{% endfor %}
  {% unless parent_present %}<p class="form-error">This extra has no main gift in your bag. You can keep it as a standalone item or remove it.</p>{% render 'cart-line', item: item, cart_context: cart_context, section: section %}{% endunless %}
 {% else %}{% render 'cart-line', item: item, cart_context: cart_context, section: section %}{% endif %}
{% endfor %}</div><div class="cart-summary">{% for discount in cart.cart_level_discount_applications %}<p>{{ discount.title | escape }} <span>−{{ discount.total_allocated_amount | money_with_currency }}</span></p>{% endfor %}<p class="subtotal">Subtotal <strong>{{ cart.total_price | money_with_currency }}</strong></p><p class="muted">Shipping and taxes calculated at checkout. Review all personalization details before ordering.</p><label for="CartNote-{{ cart_context | default: section.id }}">A note for your order (optional)</label><textarea id="CartNote-{{ cart_context | default: section.id }}" name="note" maxlength="500" rows="2" data-cart-note>{{ cart.note | escape }}</textarea><div class="cart-buttons"><button type="submit" name="update" class="button button-outline">Update bag</button><button class="button" type="submit" name="checkout">Continue to checkout {% render 'icon', name: 'arrow' %}</button></div></div></form>{% endif %}
