{{ form.errors | default_errors }}<label class="field">First name<input name="address[first_name]" value="{{ form.first_name | escape }}" autocomplete="given-name"></label><label class="field">Last name<input name="address[last_name]" value="{{ form.last_name | escape }}" autocomplete="family-name"></label><label class="field">Company<input name="address[company]" value="{{ form.company | escape }}" autocomplete="organization"></label><label class="field">Address<input name="address[address1]" value="{{ form.address1 | escape }}" autocomplete="address-line1" required></label><label class="field">Apartment or suite<input name="address[address2]" value="{{ form.address2 | escape }}" autocomplete="address-line2"></label><label class="field">City<input name="address[city]" value="{{ form.city | escape }}" autocomplete="address-level2" required></label><label class="field" for="AddressCountry-{{ id }}">Country<select id="AddressCountry-{{ id }}" name="address[country]" data-country-select data-default="{{ form.country | default: 'Pakistan' | escape }}" data-province-id="AddressProvince-{{ id }}">{{ all_country_option_tags }}</select></label><label class="field">Province<select id="AddressProvince-{{ id }}" name="address[province]" data-default="{{ form.province | escape }}"></select></label><label class="field">Postal code<input name="address[zip]" value="{{ form.zip | escape }}" autocomplete="postal-code"></label><label class="field">Phone<input name="address[phone]" value="{{ form.phone | escape }}" autocomplete="tel" type="tel"></label><label class="check-label">{{ form.set_as_default_checkbox }}Set as default address</label>
