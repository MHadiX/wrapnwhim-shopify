{% assign personalized = product.metafields.custom.personalization_enabled.value %}{% if personalized or product.template_suffix == 'personalized' or product.metafields.custom.photo_upload_enabled.value %}<fieldset class="personalization"><legend>Make it personal</legend><p class="muted">A little detail that makes it theirs.</p>{% for block in section.blocks %}{% if block.type == 'personalization' %}{% if block.settings.label == 'Gift message' %}{% if extras_enabled or greeting_enabled %}{% continue %}{% endif %}{% endif %}{% assign field_id = form_id | append: '-' | append: block.id %}<div class="field" {{ block.shopify_attributes }}><label for="{{ field_id }}">{{ block.settings.label | escape }}{% if block.settings.required %} <span aria-hidden="true">*</span>{% endif %}</label>{% if block.settings.multiline %}<textarea id="{{ field_id }}" name="properties[{{ block.settings.label | escape }}]" maxlength="{{ block.settings.limit }}" rows="3" {% if block.settings.required %}required{% endif %} data-counter data-preview-field="{{ block.settings.preview }}"></textarea>{% else %}<input id="{{ field_id }}" name="properties[{{ block.settings.label | escape }}]" maxlength="{{ block.settings.limit }}" {% if block.settings.required %}required{% endif %} data-counter data-preview-field="{{ block.settings.preview }}">{% endif %}<small data-count-for="{{ field_id }}">0 / {{ block.settings.limit }}</small></div>{% endif %}{% endfor %}{% if section.settings.enable_occasion and greeting_enabled != true %}<div class="field"><label for="Occasion-{{ form_id }}">Occasion (optional)</label><select id="Occasion-{{ form_id }}" name="properties[Occasion]"><option value="">Choose an occasion</option>{% assign occasions = 'Birthday,Anniversary,Wedding,Graduation,Baby Shower,Congratulations,Thank You,Eid,Valentine’s Day,Mother’s Day,Father’s Day,Just Because' | split: ',' %}{% for occasion in occasions %}<option>{{ occasion }}</option>{% endfor %}</select></div>{% endif %}{% if product.metafields.custom.photo_upload_enabled.value %}<div class="field"><label for="Photo-{{ form_id }}">Your photo{% if section.settings.photo_required %} *{% endif %}</label><input id="Photo-{{ form_id }}" type="file" name="properties[Personalization photo]" accept="image/jpeg,image/png,image/webp" data-upload data-max-mb="{{ section.settings.upload_limit }}" {% if section.settings.photo_required %}required{% endif %}><small>JPG, PNG, or WebP. Maximum {{ section.settings.upload_limit }} MB. Your photo will be included with your gift details. Review your personalization in the gift bag before checkout.</small><img class="upload-preview" data-upload-preview hidden width="160" height="160" alt="Preview of your selected personalization photo"><p class="form-error" data-upload-error role="alert"></p></div>{% endif %}{% if section.settings.show_preview %}<div class="personal-preview"><p class="eyebrow">AN ILLUSTRATIVE PREVIEW</p><p data-preview-name>Your special someone</p><p data-preview-message>A little note from the heart.</p><small>Placement, colors, and finish may differ from the final physical gift.</small></div>{% endif %}</fieldset>{% endif %}
