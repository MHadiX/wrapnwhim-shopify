<dialog id="SearchDrawer" class="drawer search-drawer" aria-labelledby="SearchTitle"><div class="drawer-head"><h2 id="SearchTitle">Find something thoughtful</h2><button class="icon-button" data-close type="button" aria-label="Close search">{% render 'icon', name: 'close' %}</button></div><predictive-search><form action="{{ routes.search_url }}" method="get" role="search"><label for="SearchInput">Search gifts, occasions, and collections</label><div class="input-button"><input id="SearchInput" type="search" name="q" autocomplete="off" role="combobox" aria-autocomplete="list" aria-controls="PredictiveResults" aria-expanded="false"><button type="submit" aria-label="Submit search">{% render 'icon', name: 'search' %}</button></div><input type="hidden" name="options[prefix]" value="last"></form><div id="PredictiveResults" data-results role="listbox" aria-label="Search suggestions"></div></predictive-search></dialog>
<dialog id="CartDrawer" class="drawer" aria-labelledby="CartTitle"><div class="drawer-head"><h2 id="CartTitle">Your gift bag <span data-cart-count>{{ cart.item_count }}</span></h2><button class="icon-button" data-close type="button" aria-label="Close gift bag">{% render 'icon', name: 'close' %}</button></div><div data-cart-content>{% render 'cart-content', cart_context: 'drawer' %}</div><p data-cart-error class="form-error" role="alert"></p></dialog>
<dialog id="WishlistDrawer" class="drawer" aria-labelledby="WishlistTitle"><div class="drawer-head"><h2 id="WishlistTitle">Saved for someone special</h2><button class="icon-button" data-close type="button" aria-label="Close wishlist">{% render 'icon', name: 'close' %}</button></div><wishlist-list><p>Loading your saved gifts…</p></wishlist-list>{% if settings.wishlist_page != blank %}<a class="text-link" href="{{ settings.wishlist_page.url }}">View your wishlist →</a>{% endif %}<p class="muted">Saved on this browser. Account and cross-device sync are not enabled.</p></dialog>
<dialog id="QuickView" class="quick-view" aria-label="Product quick view"><button class="icon-button quick-close" data-close type="button" aria-label="Close quick view">{% render 'icon', name: 'close' %}</button><div data-quick-content></div></dialog>
