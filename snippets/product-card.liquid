<article class="product-card"><div class="product-card-media"><a href="{{ product.url }}" tabindex="-1" aria-hidden="true">{% if product.featured_image %}{{ product.featured_image | image_url: width: 800 | image_tag: widths: '240,360,480,640,800', sizes: '(min-width: 990px) 25vw, 70vw', loading: 'lazy', class: 'product-primary' }}{% else %}{{ 'product-1' | placeholder_svg_tag: 'placeholder' }}{% endif %}{% if product.images[1] %}{{ product.images[1] | image_url: width: 800 | image_tag: widths: '360,640,800', sizes: '(min-width: 990px) 25vw, 70vw', loading: 'lazy', class: 'product-secondary' }}{% endif %}</a>{% unless product.available %}<span class="badge">Sold out</span>{% elsif product.compare_at_price > product.price %}<span class="badge">Special price</span>{% endunless %}<button type="button" class="icon-button wishlist-button" data-wishlist="{{ product.handle }}" aria-pressed="false" aria-label="Save {{ product.title | escape }}">{% render 'icon', name: 'heart' %}</button><div class="card-actions"><button class="button button-light" type="button" data-quick-view="{{ product.url }}">Choose your gift</button></div></div><div class="product-card-info"><p class="eyebrow">{{ product.type | escape }}</p><h3><a href="{{ product.url }}">{{ product.title | escape }}</a></h3>{% render 'price', product: product %}{% if product.metafields.reviews.rating.value %}<p class="rating" aria-label="{{ product.metafields.reviews.rating.value.rating }} out of {{ product.metafields.reviews.rating.value.scale_max }} stars">★ {{ product.metafields.reviews.rating.value.rating }} <span>({{ product.metafields.reviews.rating_count | default: 0 }})</span></p>{% endif %}</div></article>
