{% capture form_id %}Newsletter-{{ id }}{% endcapture %}{% form 'customer', id: form_id, class: 'newsletter-form' %}<input type="hidden" name="contact[tags]" value="newsletter"><input type="hidden" name="contact[accepts_marketing]" value="true"><label class="sr-only" for="Email-{{ id }}">Email address</label><div class="input-button"><input id="Email-{{ id }}" type="email" name="contact[email]" autocomplete="email" placeholder="Your email address" required><button type="submit" aria-label="Subscribe to newsletter">{% render 'icon', name: 'arrow' %}</button></div><small>By subscribing, you agree to receive marketing emails. Unsubscribe anytime.{% if shop.privacy_policy %} <a href="{{ shop.privacy_policy.url }}">Privacy policy</a>{% endif %}</small>{% if form.posted_successfully? %}<p role="status">Thank you. You're on the list.</p>{% endif %}{% if form.errors %}<div role="alert">{{ form.errors | default_errors }}</div>{% endif %}{% endform %}
