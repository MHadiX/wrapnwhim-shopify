<article class="cart-line" data-line-key="{{ item.key | escape }}"><a href="{{ item.url }}">{% if item.image %}{{ item.image | image_url: width: 240 | image_tag: widths: '120,240', sizes: '100px', loading: 'lazy' }}{% endif %}</a><div><h3><a href="{{ item.url }}">{{ item.product.title | escape }}</a></h3>{% unless item.product.has_only_default_variant %}<p class="muted">{{ item.variant.title | escape }}</p>{% endunless %}<dl class="line-properties">{% for property in item.properties %}{% assign initial = property.first | slice: 0 %}{% if property.last != blank and initial != '_' %}<div><dt>{{ property.first | escape }}:</dt><dd>{% assign property_url = property.last | split: '/' %}{% if property.last contains '/uploads/' and property_url[0] == 'https:' and property_url[2] == 'cdn.shopify.com' %}<a href="{{ property.last | escape }}" target="_blank" rel="noopener">View uploaded photo</a>{% else %}{{ property.last | escape }}{% endif %}</dd></div>{% endif %}{% endfor %}</dl><p>{% if item.original_line_price != item.final_line_price %}<s>{{ item.original_line_price | money_with_currency }}</s> {% endif %}{{ item.final_line_price | money_with_currency }}</p>{% for allocation in item.line_level_discount_allocations %}<p class="discount">{{ allocation.discount_application.title | escape }} (−{{ allocation.amount | money_with_currency }})</p>{% endfor %}<div class="cart-line-controls"><label class="sr-only" for="CartQuantity-{{ cart_context | default: section.id }}-{{ item.key | escape }}">Quantity for {{ item.product.title | escape }}</label><input id="CartQuantity-{{ cart_context | default: section.id }}-{{ item.key | escape }}" type="number" name="updates[{{ item.key | escape }}]" value="{{ item.quantity }}" min="0" step="{{ item.variant.quantity_rule.increment | default: 1 }}" {% if item.variant.quantity_rule.max %}max="{{ item.variant.quantity_rule.max }}"{% endif %} data-cart-quantity="{{ item.key | escape }}"><a href="{{ item.url_to_remove }}" data-cart-remove="{{ item.key | escape }}">Remove</a></div></div></article>
