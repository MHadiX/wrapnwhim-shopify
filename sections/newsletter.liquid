<section class="newsletter-section"><div class="page-width"><p class="eyebrow">{{ section.settings.eyebrow | escape }}</p><h2>{{ section.settings.heading | escape }}</h2><p>{{ section.settings.text | escape }}</p>{% render 'newsletter-form', id: section.id %}</div></section>
{% schema %}
{
  "name": "Newsletter",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "LET GOOD THINGS FIND YOU"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Stay in the loop. Share in the joy."
    },
    {
      "type": "text",
      "id": "text",
      "label": "Text",
      "default": "Thoughtful inspiration, fresh collections, and a little something special in your inbox."
    }
  ],
  "presets": [
    {
      "name": "Newsletter"
    }
  ]
}
{% endschema %}
