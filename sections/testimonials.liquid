<section class="section reviews-section"><div class="page-width"><div class="section-heading centered"><div><p class="eyebrow">{{ section.settings.eyebrow | escape }}</p><h2>{{ section.settings.heading | escape }}</h2></div></div>{% if section.blocks.size > 0 %}<scroll-carousel><div class="review-carousel" data-scroll>{% for block in section.blocks %}<figure class="review-card" {{ block.shopify_attributes }}>{% if block.settings.demo %}<p class="demo-label">DEMONSTRATION REVIEW · NOT A CUSTOMER TESTIMONIAL</p>{% endif %}<div class="stars" aria-label="{{ block.settings.rating }} out of 5 stars">{% for i in (1..block.settings.rating) %}★{% endfor %}</div><blockquote>{{ block.settings.quote | escape }}</blockquote><figcaption>{% if block.settings.image %}{{ block.settings.image | image_url: width: 100 | image_tag: loading: 'lazy' }}{% endif %}{{ block.settings.name | escape }}</figcaption></figure>{% endfor %}</div><div class="carousel-controls"><button type="button" data-prev class="icon-button" aria-label="Previous review">←</button><button type="button" data-next class="icon-button" aria-label="Next review">→</button></div></scroll-carousel>{% else %}<p class="centered muted">Every gift has a story. Customer stories will appear here when shared with permission.</p>{% endif %}</div></section>
{% schema %}
{
  "name": "Customer stories",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "LITTLE GIFTS. BIG FEELINGS."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The joy of giving."
    }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        {
          "type": "textarea",
          "id": "quote",
          "label": "Review",
          "default": "A thoughtful note makes even a small gift feel special."
        },
        {
          "type": "text",
          "id": "name",
          "label": "Customer name",
          "default": "Example story"
        },
        {
          "type": "range",
          "id": "rating",
          "label": "Rating",
          "min": 1,
          "max": 5,
          "step": 1,
          "default": 5
        },
        {
          "type": "checkbox",
          "id": "demo",
          "label": "Show demonstration label",
          "default": true
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Customer photo"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Customer stories"
    }
  ]
}
{% endschema %}
