<section class="section page-width"><div class="page-heading"><p class="eyebrow">A WORLD OF THOUGHTFUL GIFTS</p><h1>Find a little joy.</h1></div>{% paginate collections by 24 %}<div class="image-grid columns-4">{% for collection in collections %}<a href="{{ collection.url }}" class="image-card"><div class="image-card-photo">{% render 'image', image: collection.featured_image, alt: collection.title %}</div><h2>{{ collection.title | escape }} ↗</h2></a>{% else %}<p>New collections are on their way.</p>{% endfor %}</div>{% render 'pagination', paginate: paginate %}{% endpaginate %}</section>
{% schema %}
{
  "name": "All collections"
}
{% endschema %}
