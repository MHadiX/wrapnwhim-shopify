<section class="section page-width"><div class="page-heading"><p class="eyebrow">A WORLD OF THOUGHTFUL GIFTS</p><h1>Find a little joy.</h1><p>Explore thoughtfully chosen gifts for every person and every occasion.</p></div>{% paginate collections by 24 %}<div class="image-grid columns-4 collection-directory">{% for collection in collections %}<a href="{{ collection.url }}" class="collection-card"><div class="collection-card-media">{% render 'image', image: collection.featured_image, alt: collection.title, sizes: '(min-width: 990px) 25vw, 50vw' %}</div><div class="collection-card-body"><h2>{{ collection.title | escape }}</h2><span class="collection-card-arrow" aria-hidden="true">{% render 'icon', name: 'diagonal-arrow' %}</span></div></a>{% else %}<p>New collections are on their way.</p>{% endfor %}</div>{% render 'pagination', paginate: paginate %}{% endpaginate %}</section>
{% schema %}
{
  "name": "All collections"
}
{% endschema %}
