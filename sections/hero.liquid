<hero-slideshow class="hero" data-autoplay="{{ section.settings.autoplay }}" data-speed="{{ section.settings.speed | times: 1000 }}" role="region" aria-roledescription="carousel" aria-label="{{ section.settings.label | escape }}"><div class="hero-slides">{% for block in section.blocks %}<article class="hero-slide {{ block.settings.position }} mobile-{{ block.settings.mobile_position }}" data-slide {% unless forloop.first %}hidden{% endunless %} aria-roledescription="slide" aria-label="{{ forloop.index }} of {{ section.blocks.size }}" {{ block.shopify_attributes }}><div class="hero-image">{% if block.settings.mobile_image %}<picture><source media="(max-width: 749px)" srcset="{{ block.settings.mobile_image | image_url: width: 480 }} 480w, {{ block.settings.mobile_image | image_url: width: 900 }} 900w">{% if forloop.first %}{% render 'image', image: block.settings.image, loading: 'eager', sizes: '100vw', alt: block.settings.heading %}{% else %}{% render 'image', image: block.settings.image, sizes: '100vw', alt: block.settings.heading %}{% endif %}</picture>{% else %}<picture>{% if block.settings.image == blank %}<source media="(max-width: 749px)" srcset="{{ 'gifting-mobile.webp' | asset_url }}">{% endif %}{% if forloop.first %}{% render 'image', image: block.settings.image, loading: 'eager', sizes: '100vw', alt: block.settings.heading %}{% else %}{% render 'image', image: block.settings.image, sizes: '100vw', alt: block.settings.heading %}{% endif %}</picture>{% endif %}</div><div class="hero-copy page-width"><p class="eyebrow">{{ block.settings.eyebrow | escape }}</p>{% if forloop.first %}<h1>{{ block.settings.heading | escape }}</h1>{% else %}<h2>{{ block.settings.heading | escape }}</h2>{% endif %}<p class="hero-description">{{ block.settings.description | escape }}</p><a class="button" href="{{ block.settings.link | default: routes.all_products_collection_url }}">{{ block.settings.button | escape }} {% render 'icon', name: 'arrow' %}</a><p class="hero-footnote">{{ block.settings.note | escape }}</p></div></article>{% endfor %}</div>{% if section.blocks.size > 1 %}<div class="hero-controls"><button type="button" data-prev aria-label="Previous slide">←</button><div class="hero-dots">{% for block in section.blocks %}<button type="button" data-dot="{{ forloop.index0 }}" aria-label="Go to slide {{ forloop.index }}" aria-pressed="{% if forloop.first %}true{% else %}false{% endif %}"></button>{% endfor %}</div><button type="button" data-next aria-label="Next slide">→</button><button type="button" data-pause aria-label="Pause slideshow">Pause</button></div>{% endif %}</hero-slideshow>
{% schema %}
{
  "name": "Editorial slideshow",
  "max_blocks": 5,
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "Accessible label",
      "default": "Gift inspiration"
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Autoplay",
      "default": false
    },
    {
      "type": "range",
      "id": "speed",
      "label": "Slide interval",
      "min": 5,
      "max": 12,
      "step": 1,
      "default": 7,
      "unit": "s"
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "image_picker",
          "id": "mobile_image",
          "label": "Mobile image"
        },
        {
          "type": "text",
          "id": "eyebrow",
          "label": "Eyebrow",
          "default": "MADE TO MEAN MORE"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "The art of thoughtful gifting."
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "For every person, every occasion, and every little reason to make someone smile."
        },
        {
          "type": "text",
          "id": "button",
          "label": "Button label",
          "default": "Discover the collection"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        },
        {
          "type": "text",
          "id": "note",
          "label": "Small note",
          "default": "CURATED WITH CARE \u00b7 WRAPPED WITH LOVE"
        },
        {
          "type": "select",
          "id": "position",
          "label": "Desktop text placement",
          "default": "left",
          "options": [
            {
              "value": "left",
              "label": "Left"
            },
            {
              "value": "right",
              "label": "Right"
            }
          ]
        },
        {
          "type": "select",
          "id": "mobile_position",
          "label": "Mobile text placement",
          "default": "bottom",
          "options": [
            {
              "value": "top",
              "label": "Top"
            },
            {
              "value": "bottom",
              "label": "Bottom"
            }
          ]
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Editorial slideshow",
      "blocks": [
        {
          "type": "slide"
        }
      ]
    }
  ]
}
{% endschema %}
