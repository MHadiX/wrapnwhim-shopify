{% liquid
  assign selected_collection = section.settings.collection
  if selected_collection == blank and section.settings.fallback_all
    assign selected_collection = collections.all
  endif
%}
{% if selected_collection.products_count > 0 or request.design_mode %}
<section class="section page-width featured-section"><div class="section-heading"><div><p class="eyebrow">{{ section.settings.eyebrow | escape }}</p><h2>{{ section.settings.heading | escape }}</h2></div>{% if selected_collection %}<a class="text-link" href="{{ selected_collection.url }}">View collection {% render 'icon', name: 'arrow' %}</a>{% endif %}</div>
  {% if selected_collection.products_count > 0 %}<scroll-carousel><div class="product-carousel" data-scroll>{% for product in selected_collection.products limit: section.settings.limit %}{% render 'product-card', product: product %}{% endfor %}</div><div class="carousel-controls"><button class="icon-button" data-prev type="button" aria-label="Previous products">←</button><button class="icon-button" data-next type="button" aria-label="Next products">→</button></div></scroll-carousel>{% else %}<div class="editorial-empty"><p>Select a collection to bring this section to life.</p><p class="muted">Only real products and live Shopify prices are shown to shoppers.</p></div>{% endif %}
</section>
{% endif %}
{% schema %}
{
  "name": "Featured products",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "THOUGHTFULLY CHOSEN"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Gifts they\u2019ll love."
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "limit",
      "label": "Products to display",
      "min": 4,
      "max": 16,
      "step": 1,
      "default": 8
    },
    {
      "type": "checkbox",
      "id": "fallback_all",
      "label": "Use all products when no collection is selected",
      "default": false
    }
  ],
  "presets": [
    {
      "name": "Featured products"
    }
  ]
}
{% endschema %}
