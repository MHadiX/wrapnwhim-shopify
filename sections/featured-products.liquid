<section class="section page-width"><div class="section-heading"><div><p class="eyebrow">{{ section.settings.eyebrow | escape }}</p><h2>{{ section.settings.heading | escape }}</h2></div>{% if section.settings.collection %}<a class="text-link" href="{{ section.settings.collection.url }}">View collection ↗</a>{% endif %}</div>{% if section.settings.collection.products_count > 0 %}<scroll-carousel><div class="product-carousel" data-scroll>{% for product in section.settings.collection.products limit: section.settings.limit %}{% render 'product-card', product: product %}{% endfor %}</div><div class="carousel-controls"><button class="icon-button" data-prev type="button" aria-label="Previous products">←</button><button class="icon-button" data-next type="button" aria-label="Next products">→</button></div></scroll-carousel>{% else %}<div class="editorial-empty"><p>A collection of little luxuries, coming together.</p><p class="muted">{% if request.design_mode %}Select a collection in this section to display real products and live prices.{% else %}Explore our collections to find your next thoughtful gift.{% endif %}</p><a class="text-link" href="{{ routes.all_products_collection_url }}">Explore the shop →</a></div>{% endif %}</section>
{% schema %}
{
  "name": "Featured products",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "THOUGHTFULLY CHOSEN"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Gifts they\u2019ll love."
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "limit",
      "label": "Products to display",
      "min": 4,
      "max": 16,
      "step": 1,
      "default": 8
    }
  ],
  "presets": [
    {
      "name": "Featured products"
    }
  ]
}
{% endschema %}
