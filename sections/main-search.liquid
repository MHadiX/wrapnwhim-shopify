<section class="section page-width">{% render 'breadcrumbs' %}<div class="page-heading"><p class="eyebrow">FIND THEIR NEXT FAVORITE</p><h1>Search the little things.</h1><form action="{{ routes.search_url }}" method="get" role="search"><label class="sr-only" for="PageSearch">Search gifts</label><div class="input-button"><input type="search" id="PageSearch" name="q" value="{{ search.terms | escape }}" placeholder="What would make them smile?"><button type="submit" aria-label="Search">{% render 'icon', name: 'search' %}</button></div><input type="hidden" name="type" value="product"><input type="hidden" name="options[prefix]" value="last"></form></div>{% if search.performed %}{% render 'filters', results: search %}<p>{{ search.results_count }} results for “{{ search.terms | escape }}”</p>{% paginate search.results by 16 %}<div class="product-grid">{% for item in search.results %}{% if item.object_type == 'product' %}{% render 'product-card', product: item %}{% else %}<a href="{{ item.url }}">{{ item.title | escape }}</a>{% endif %}{% else %}<div class="editorial-empty"><h2>No gifts found just yet.</h2><p>Try a different name, occasion, or kind of gift.</p><a href="{{ routes.all_products_collection_url }}" class="button">Explore all gifts</a></div>{% endfor %}</div>{% render 'pagination', paginate: paginate %}{% endpaginate %}{% endif %}</section>
{% schema %}
{
  "name": "Search results"
}
{% endschema %}
