<div class="trust-bar page-width">{% for block in section.blocks %}<div {{ block.shopify_attributes }}>{% render 'icon', name: block.settings.icon %}<div><strong>{{ block.settings.heading | escape }}</strong><span>{{ block.settings.text | escape }}</span></div></div>{% endfor %}</div>
{% schema %}
{
  "name": "Service highlights",
  "blocks": [
    {
      "type": "highlight",
      "name": "Highlight",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "default": "gift",
          "options": [
            {
              "value": "gift",
              "label": "Gift"
            },
            {
              "value": "truck",
              "label": "Delivery"
            },
            {
              "value": "heart",
              "label": "Heart"
            },
            {
              "value": "message",
              "label": "Support"
            }
          ]
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Thoughtfully curated"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Little details. Lasting impressions."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Service highlights"
    }
  ]
}
{% endschema %}
