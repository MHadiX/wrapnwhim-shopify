<section class="collection-banner">
  <div class="page-width collection-heading"><div>{% render 'breadcrumbs' %}<p class="eyebrow">THE WRAPNWHIM COLLECTION</p><h1>{{ collection.title | escape }}</h1><div class="rte">{{ collection.description }}</div></div>{% if collection.image %}<div class="collection-banner-image">{{ collection.image | image_url: width: 1200 | image_tag: widths: '480,800,1200', sizes: '(min-width: 990px) 35vw, 100vw', loading: 'eager' }}</div>{% endif %}</div>
</section>
<section class="section page-width shopping-section">
  <div class="catalog-layout">{% render 'filters', results: collection %}<div class="catalog-results" id="CollectionResults"><div class="catalog-toolbar"><p>{{ collection.products_count }} {% if collection.products_count == 1 %}gift{% else %}gifts{% endif %}</p><a class="text-link" href="{{ routes.collections_url }}">Explore collections</a></div>{% render 'active-filters', results: collection %}
    {% paginate collection.products by section.settings.per_page %}<div class="product-grid">{% for product in collection.products %}{% render 'product-card', product: product %}{% else %}<div class="editorial-empty"><h2>No gifts match these filters.</h2><p>Try a different selection to find something thoughtful.</p><a class="button button-outline" href="{{ collection.url }}">Clear filters</a></div>{% endfor %}</div>{% render 'pagination', paginate: paginate %}{% endpaginate %}
  </div></div>
</section>
{% schema %}
{
  "name": "Collection",
  "settings": [
    {
      "type": "range",
      "id": "per_page",
      "label": "Products per page",
      "min": 8,
      "max": 32,
      "step": 4,
      "default": 16
    }
  ]
}
{% endschema %}
