<section class="section page-width"><div class="section-heading"><div><p class="eyebrow">{{ section.settings.eyebrow | escape }}</p><h2>{{ section.settings.heading | escape }}</h2></div>{% if section.settings.link != blank %}<a class="text-link" href="{{ section.settings.link }}">{{ section.settings.link_label | escape }} ↗</a>{% endif %}</div><div class="inspiration-grid">{% for block in section.blocks %}<div {{ block.shopify_attributes }}>{% if block.settings.link %}<a href="{{ block.settings.link }}">{% endif %}{% render 'image', image: block.settings.image, fallback: block.settings.demo_asset, alt: block.settings.alt, sizes: '(min-width: 750px) 25vw, 50vw' %}{% if block.settings.link %}</a>{% endif %}</div>{% endfor %}</div></section>
{% schema %}
{
  "name": "Gifting inspiration",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "MOMENTS WORTH SHARING"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "A little inspiration, beautifully wrapped."
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Link label",
      "default": "Follow our story"
    }
  ],
  "blocks": [
    {
      "type": "photo",
      "name": "Photo",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "alt",
          "label": "Image description",
          "default": "Thoughtful gifts in warm ivory and navy"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        },
        {
          "type": "select",
          "id": "demo_asset",
          "label": "Demo photograph",
          "default": "giftbox.webp",
          "options": [
            {
              "value": "personal.webp",
              "label": "Personal"
            },
            {
              "value": "flowers.webp",
              "label": "Flowers"
            },
            {
              "value": "chocolates.webp",
              "label": "Chocolates"
            },
            {
              "value": "giftbox.webp",
              "label": "Giftbox"
            },
            {
              "value": "lifestyle.webp",
              "label": "Lifestyle"
            },
            {
              "value": "wedding.webp",
              "label": "Wedding"
            }
          ]
        }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "Gifting inspiration"
    }
  ]
}
{% endschema %}
