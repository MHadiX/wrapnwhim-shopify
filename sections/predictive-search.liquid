{% if predictive_search.performed %}<div class="predictive-results">{% if predictive_search.resources.products.size > 0 %}<h3 role="presentation">Gifts</h3>{% for product in predictive_search.resources.products %}<a role="option" aria-selected="false" href="{{ product.url }}" class="predictive-item">{% if product.featured_image %}{{ product.featured_image | image_url: width: 120 | image_tag: loading: 'lazy' }}{% endif %}<span>{{ product.title | escape }}<small>{{ product.price | money_with_currency }}</small></span></a>{% endfor %}{% endif %}{% if predictive_search.resources.collections.size > 0 %}<h3 role="presentation">Collections</h3>{% for collection in predictive_search.resources.collections %}<a role="option" aria-selected="false" href="{{ collection.url }}">{{ collection.title | escape }}</a>{% endfor %}{% endif %}{% if predictive_search.resources.queries.size > 0 %}<h3 role="presentation">Suggestions</h3>{% for query in predictive_search.resources.queries %}<a role="option" aria-selected="false" href="{{ query.url }}">{{ query.text | escape }}</a>{% endfor %}{% endif %}<a role="option" aria-selected="false" class="text-link" href="{{ routes.search_url }}?q={{ predictive_search.terms | url_encode }}&type=product">See all results for “{{ predictive_search.terms | escape }}” →</a></div>{% endif %}
{% schema %}
{
  "name": "Predictive search"
}
{% endschema %}
