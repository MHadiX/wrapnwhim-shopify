{% if section.blocks.size > 0 %}<announcement-bar class="announcement" data-speed="{{ section.settings.speed | times: 1000 }}">{% for block in section.blocks %}<div data-announcement {% unless forloop.first %}hidden{% endunless %} {{ block.shopify_attributes }}>{% if block.settings.link != blank %}<a href="{{ block.settings.link }}">{{ block.settings.text | escape }}</a>{% else %}{{ block.settings.text | escape }}{% endif %}</div>{% endfor %}{% if section.blocks.size > 1 %}<button type="button" data-pause aria-label="Pause announcements">Pause</button>{% endif %}</announcement-bar>{% endif %}
{% schema %}
{
  "name": "Announcement bar",
  "settings": [
    {
      "type": "range",
      "id": "speed",
      "label": "Rotation interval",
      "min": 4,
      "max": 12,
      "step": 1,
      "unit": "s",
      "default": 6
    }
  ],
  "blocks": [
    {
      "type": "announcement",
      "name": "Announcement",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Message",
          "default": "Thoughtfully chosen. Beautifully wrapped. Made to mean more."
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "max_blocks": 6
}
{% endschema %}
