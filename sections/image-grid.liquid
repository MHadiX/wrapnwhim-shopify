<section class="section page-width"><div class="section-heading"><div><p class="eyebrow">{{ section.settings.eyebrow | escape }}</p><h2>{{ section.settings.heading | escape }}</h2></div>{% if section.settings.link != blank %}<a class="text-link" href="{{ section.settings.link }}">{{ section.settings.link_label | escape }} ↗</a>{% endif %}</div><div class="image-grid columns-{{ section.settings.columns }} {% if section.settings.round %}round-grid{% endif %}">{% for block in section.blocks %}{% assign destination = block.settings.link | default: block.settings.collection.url | default: routes.collections_url %}<a class="image-card" href="{{ destination }}" {{ block.shopify_attributes }}><div class="image-card-photo">{% assign card_image = block.settings.image | default: block.settings.collection.featured_image %}{% render 'image', image: card_image, fallback: block.settings.demo_asset, alt: block.settings.title, sizes: '(min-width: 990px) 25vw, 50vw' %}</div><h3>{{ block.settings.title | default: block.settings.collection.title | escape }} <span aria-hidden="true">↗</span></h3>{% if block.settings.subtitle != blank %}<p>{{ block.settings.subtitle | escape }}</p>{% endif %}</a>{% endfor %}</div></section>
{% schema %}
{
  "name": "Categories or occasions",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "A LITTLE SOMETHING FOR EVERYONE"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Find their kind of joy."
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Link label",
      "default": "Explore all gifts"
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Desktop columns",
      "min": 3,
      "max": 6,
      "step": 1,
      "default": 4
    },
    {
      "type": "checkbox",
      "id": "round",
      "label": "Circular images",
      "default": false
    }
  ],
  "max_blocks": 16,
  "blocks": [
    {
      "type": "card",
      "name": "Collection card",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Personalized gifts"
        },
        {
          "type": "text",
          "id": "subtitle",
          "label": "Subtitle"
        },
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        },
        {
          "type": "select",
          "id": "demo_asset",
          "label": "Demo photograph",
          "default": "giftbox.webp",
          "options": [
            {
              "value": "personal.webp",
              "label": "Personal gift"
            },
            {
              "value": "flowers.webp",
              "label": "Flowers"
            },
            {
              "value": "chocolates.webp",
              "label": "Chocolates"
            },
            {
              "value": "giftbox.webp",
              "label": "Gift box"
            },
            {
              "value": "lifestyle.webp",
              "label": "Home and lifestyle"
            },
            {
              "value": "wedding.webp",
              "label": "Wedding"
            }
          ]
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Categories or occasions",
      "blocks": [
        {
          "type": "card"
        },
        {
          "type": "card"
        },
        {
          "type": "card"
        },
        {
          "type": "card"
        }
      ]
    }
  ]
}
{% endschema %}
