<product-recommendations data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit=4&intent=related"><section class="section page-width">{% if recommendations.performed? and recommendations.products_count > 0 %}<div class="section-heading"><div><p class="eyebrow">A LITTLE MORE TO LOVE</p><h2>{{ section.settings.heading | escape }}</h2></div></div><div class="product-grid">{% for product in recommendations.products %}{% render 'product-card', product: product %}{% endfor %}</div>{% endif %}</section></product-recommendations>
{% schema %}
{
  "name": "Related products",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Beautiful things, better together."
    }
  ]
}
{% endschema %}
