<div class="quick-product-content"><div>{% render 'image', image: product.featured_image, alt: product.title %}</div><div><p class="eyebrow">A CLOSER LOOK</p><h2>{{ product.title | escape }}</h2>{% if product.metafields.custom.personalization_enabled.value or product.template_suffix == 'personalized' or product.metafields.custom.photo_upload_enabled.value %}<p>This gift has personal details to choose. Visit the product page to make it yours.</p>{% render 'price', product: product %}<a class="button" href="{{ product.url }}">Personalize your gift →</a>{% else %}{% render 'product-form', product: product, section: section %}<a class="text-link" href="{{ product.url }}">View all details →</a>{% endif %}</div></div>
{% schema %}
{
  "name": "Quick view",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_dynamic_checkout",
      "label": "Show Shopify express checkout",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "enable_occasion",
      "label": "Show occasion field on personalized gifts",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_preview",
      "label": "Show illustrative text preview",
      "default": true
    },
    {
      "type": "range",
      "id": "upload_limit",
      "label": "Upload size limit (MB)",
      "min": 1,
      "max": 20,
      "step": 1,
      "default": 10
    },
    {
      "type": "checkbox",
      "id": "photo_required",
      "label": "Require photo when photo upload metafield is enabled",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "personalization",
      "name": "Personalization field",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Field label",
          "default": "Recipient name"
        },
        {
          "type": "range",
          "id": "limit",
          "label": "Character limit",
          "min": 20,
          "max": 500,
          "step": 10,
          "default": 100
        },
        {
          "type": "checkbox",
          "id": "required",
          "label": "Required",
          "default": false
        },
        {
          "type": "checkbox",
          "id": "multiline",
          "label": "Multiline",
          "default": false
        },
        {
          "type": "select",
          "id": "preview",
          "label": "Preview target",
          "default": "name",
          "options": [
            {
              "value": "name",
              "label": "Name"
            },
            {
              "value": "message",
              "label": "Message"
            },
            {
              "value": "none",
              "label": "No preview"
            }
          ]
        }
      ]
    },
    {
      "type": "accordion",
      "name": "Information accordion",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Delivery and gifting"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Content",
          "default": "<p>Delivery options and charges are shown at checkout. Add a gift message to make it personal.</p>"
        }
      ]
    }
  ]
}
{% endschema %}
