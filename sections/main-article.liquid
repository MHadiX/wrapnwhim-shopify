<article class="section page-width prose-page"><div class="page-heading"><p class="eyebrow">{{ blog.title | escape }} · {{ article.published_at | date: '%B %d, %Y' }}</p><h1>{{ article.title | escape }}</h1></div>{% if article.image %}{% render 'image', image: article.image, alt: article.title %}{% endif %}<div class="rte">{{ article.content }}</div><a class="text-link" href="{{ blog.url }}">← Back to the journal</a><script type="application/ld+json">{{ article | structured_data }}</script></article>
{% schema %}
{
  "name": "Journal article"
}
{% endschema %}
