<footer class="site-footer"><div class="page-width footer-grid"><div><a href="{{ routes.root_url }}" class="wordmark">Wrap<span>n</span>Whim</a><p>{{ section.settings.description | escape }}</p>{% if section.settings.email != blank %}<a href="mailto:{{ section.settings.email | escape }}">{{ section.settings.email | escape }}</a>{% endif %}{% if section.settings.phone != blank %}<p>{{ section.settings.phone | escape }}</p>{% endif %}<div class="social-links">{% for block in section.blocks %}<a href="{{ block.settings.link }}" {{ block.shopify_attributes }}>{{ block.settings.label | escape }}</a>{% endfor %}</div></div>{% for i in (1..2) %}{% capture menu_id %}menu_{{ i }}{% endcapture %}<div><h2>{{ section.settings[menu_id].title | default: 'Explore' | escape }}</h2>{% for link in section.settings[menu_id].links %}<a href="{{ link.url }}">{{ link.title | escape }}</a>{% endfor %}{% if i == 2 %}{% for policy in shop.policies %}{% if policy.body != blank %}<a href="{{ policy.url }}">{{ policy.title | escape }}</a>{% endif %}{% endfor %}{% endif %}</div>{% endfor %}<div><h2>A little joy in your inbox</h2><p>Gift inspiration, new arrivals, and thoughtful little extras.</p>{% render 'newsletter-form', id: section.id %}</div></div><div class="page-width footer-bottom"><p>© {{ 'now' | date: '%Y' }} {{ shop.name | escape }} · {{ section.settings.location | escape }}</p><div class="payment-icons">{% for type in shop.enabled_payment_types %}{{ type | payment_type_svg_tag: class: 'payment-icon' }}{% endfor %}</div></div></footer>
{% schema %}
{
  "name": "Footer",
  "settings": [
    {
      "type": "text",
      "id": "description",
      "label": "Brand description",
      "default": "Thoughtful gifts, beautifully curated. For the people and moments that mean the most."
    },
    {
      "type": "link_list",
      "id": "menu_1",
      "label": "Quick links"
    },
    {
      "type": "link_list",
      "id": "menu_2",
      "label": "Customer support links"
    },
    {
      "type": "text",
      "id": "email",
      "label": "Support email"
    },
    {
      "type": "text",
      "id": "phone",
      "label": "Support phone"
    },
    {
      "type": "text",
      "id": "location",
      "label": "Location",
      "default": "Pakistan"
    }
  ],
  "blocks": [
    {
      "type": "social",
      "name": "Social link",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Instagram"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ]
}
{% endschema %}
