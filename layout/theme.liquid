<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="theme-color" content="{{ settings.color_navy | default: '#101B2D' }}">
  <title>{{ page_title | escape }}{% if current_tags %} — {{ current_tags | join: ', ' | escape }}{% endif %}{% if current_page != 1 %} — Page {{ current_page }}{% endif %}{% unless page_title contains shop.name %} — {{ shop.name | escape }}{% endunless %}</title>
  {% if page_description %}<meta name="description" content="{{ page_description | escape }}">{% endif %}
  <link rel="canonical" href="{{ canonical_url }}">
  {% render 'social-meta' %}
  {% if settings.favicon %}<link rel="icon" href="{{ settings.favicon | image_url: width: 32 }}">{% endif %}
  {% if settings.use_shopify_fonts and settings.heading_font.family != blank %}
    {% unless settings.heading_font.system? %}{{ settings.heading_font | font_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: 'anonymous' }}{% endunless %}
  {% endif %}
  {% if settings.use_shopify_fonts and settings.body_font.family != blank %}
    {% unless settings.body_font.system? %}{{ settings.body_font | font_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: 'anonymous' }}{% endunless %}
  {% endif %}
  {{ 'theme.css' | asset_url | stylesheet_tag }}
  {% style %}
    {% if settings.use_shopify_fonts and settings.heading_font.family != blank %}{{ settings.heading_font | font_face: font_display: 'swap' }}{% endif %}
    {% if settings.use_shopify_fonts and settings.body_font.family != blank %}{{ settings.body_font | font_face: font_display: 'swap' }}{% endif %}
    :root {
      --navy: {{ settings.color_navy | default: '#101B2D' }};
      --champagne: {{ settings.color_champagne | default: '#D8BE91' }};
      --ivory: {{ settings.color_ivory | default: '#FAF8F3' }};
      --beige: {{ settings.color_beige | default: '#F1EBE1' }};
      --ink: {{ settings.color_text | default: '#252525' }};
      --card-ratio: {{ settings.card_ratio | default: '4 / 5' }};
      --card-image-fit: {{ settings.card_image_fit | default: 'cover' }};
      --heading: Georgia, 'Times New Roman', serif;
      --body: Arial, Helvetica, sans-serif;
      {% if settings.use_shopify_fonts and settings.heading_font.family != blank %}--heading: {{ settings.heading_font.family | json }}, {{ settings.heading_font.fallback_families | default: 'serif' }};{% endif %}
      {% if settings.use_shopify_fonts and settings.body_font.family != blank %}--body: {{ settings.body_font.family | json }}, {{ settings.body_font.fallback_families | default: 'sans-serif' }};{% endif %}
    }
  {% endstyle %}
  {{ content_for_header }}
  <script src="{{ 'core.js' | asset_url }}" defer></script>
  <script src="{{ 'theme.js' | asset_url }}" defer></script>
</head>
<body>
  <a class="skip-link" href="#MainContent">Skip to content</a>
  {% sections 'header-group' %}
  <noscript><nav class="page-width" aria-label="Quick navigation"><a href="{{ routes.root_url }}">Home</a> · <a href="{{ routes.all_products_collection_url }}">Shop gifts</a> · <a href="{{ routes.search_url }}">Search</a> · <a href="{{ routes.cart_url }}">Shopping bag</a></nav></noscript>
  <main id="MainContent" tabindex="-1">{{ content_for_layout }}</main>
  {% sections 'footer-group' %}
  {% render 'drawers' %}
  {% if settings.whatsapp_number != blank %}<a class="whatsapp" href="https://wa.me/{{ settings.whatsapp_number | remove: '+' | remove: ' ' | escape }}" target="_blank" rel="noopener" aria-label="Contact WrapnWhim on WhatsApp">{% render 'icon', name: 'message' %}<span>How can we help?</span></a>{% endif %}
  <div class="sr-only" role="status" aria-live="polite" id="StoreStatus"></div>
  <script id="StoreConfig" type="application/json">{"root": {{ routes.root_url | json }}, "currency": {{ cart.currency.iso_code | default: shop.currency | json }}}</script>
</body></html>
