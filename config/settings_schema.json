[
  {
    "name": "theme_info",
    "theme_name": "WrapnWhim",
    "theme_version": "2.2.1",
    "theme_author": "WrapnWhim",
    "theme_documentation_url": "https://github.com/MHadiX/wrapnwhim-shopify",
    "theme_support_url": "https://github.com/MHadiX/wrapnwhim-shopify/issues"
  },
  {
    "name": "Brand and typography",
    "settings": [
      {
        "type": "image_picker",
        "id": "logo",
        "label": "Logo"
      },
      {
        "type": "image_picker",
        "id": "brand_icon",
        "label": "Logo icon",
        "info": "Optional gift-box icon beside the wordmark. Also used as the favicon if no separate favicon is selected."
      },
      {
        "type": "image_picker",
        "id": "footer_logo",
        "label": "Footer logo (optional)"
      },
      {
        "type": "image_picker",
        "id": "favicon",
        "label": "Favicon"
      },
      {
        "type": "checkbox",
        "id": "use_shopify_fonts",
        "label": "Use selected Shopify fonts",
        "default": false,
        "info": "Off uses Georgia headings and Arial text, matching the supplied design previews. Enable after choosing fonts below."
      },
      {
        "type": "font_picker",
        "id": "heading_font",
        "label": "Heading font",
        "default": "assistant_n4"
      },
      {
        "type": "font_picker",
        "id": "body_font",
        "label": "Body font",
        "default": "assistant_n4"
      },
      {
        "type": "color",
        "id": "color_navy",
        "label": "Midnight navy",
        "default": "#101B2D"
      },
      {
        "type": "color",
        "id": "color_champagne",
        "label": "Champagne",
        "default": "#D8BE91"
      },
      {
        "type": "color",
        "id": "color_ivory",
        "label": "Warm ivory",
        "default": "#FAF8F3"
      },
      {
        "type": "color",
        "id": "color_beige",
        "label": "Soft beige",
        "default": "#F1EBE1"
      },
      {
        "type": "color",
        "id": "color_text",
        "label": "Charcoal",
        "default": "#252525"
      }
    ]
  },
  {
    "name": "Product cards",
    "settings": [
      {
        "type": "select",
        "id": "card_ratio",
        "label": "Image proportions",
        "default": "4 / 5",
        "options": [
          {
            "value": "1 / 1",
            "label": "Square"
          },
          {
            "value": "4 / 5",
            "label": "Portrait"
          },
          {
            "value": "3 / 4",
            "label": "Tall portrait"
          }
        ]
      },
      {
        "type": "select",
        "id": "card_image_fit",
        "label": "Image fit",
        "default": "cover",
        "options": [
          {
            "value": "contain",
            "label": "Show full product"
          },
          {
            "value": "cover",
            "label": "Fill image area"
          }
        ]
      },
      {
        "type": "checkbox",
        "id": "show_product_type",
        "label": "Show product type on cards",
        "default": false
      }
    ]
  },
  {
    "name": "Customer support",
    "settings": [
      {
        "type": "text",
        "id": "whatsapp_number",
        "label": "WhatsApp number (international digits only)"
      },
      {
        "type": "text",
        "id": "delivery_message",
        "label": "Delivery message",
        "default": "Delivery timing is confirmed at checkout."
      },
      {
        "type": "text",
        "id": "cod_message",
        "label": "Payment information",
        "default": "Available payment options are shown at checkout."
      },
      {
        "type": "page",
        "id": "wishlist_page",
        "label": "Wishlist page"
      }
    ]
  },
  {
    "name": "Gift extras",
    "settings": [
      {
        "type": "checkbox",
        "id": "gift_extras_all_products",
        "label": "Offer configured extras on all eligible products",
        "default": true
      },
      {
        "type": "product_list",
        "id": "default_gift_extras",
        "label": "Default extra products",
        "limit": 12
      },
      {
        "type": "range",
        "id": "gift_extra_max",
        "label": "Default maximum quantity per extra",
        "min": 1,
        "max": 20,
        "step": 1,
        "default": 5
      }
    ]
  },
  {
    "name": "Greeting cards",
    "settings": [
      {
        "type": "checkbox",
        "id": "greeting_card_enabled",
        "label": "Show free greeting card fields",
        "default": true
      },
      {
        "type": "text",
        "id": "greeting_occasions",
        "label": "Greeting occasions (comma separated)",
        "default": "Birthday,Anniversary,Wedding,Congratulations,Thank You,Get Well Soon,New Baby,Graduation,Eid,Just Because"
      },
      {
        "type": "text",
        "id": "greeting_card_help",
        "label": "Greeting occasion help text",
        "default": "Select occasion for free greeting card"
      }
    ]
  }
]
